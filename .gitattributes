# Keep repository text deterministic across Linux and Windows CI.
*.php text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.ps1 text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Native Windows command scripts retain CRLF semantics.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
