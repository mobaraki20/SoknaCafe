<?xml version="1.0"?>
<ruleset name="Cafe QR Ordering">
    <description>قواعد پیشنهادی کدنویسی پروژه</description>
    <file>admin</file>
    <file>api</file>
    <file>includes</file>
    <file>operator</file>
    <file>waiter</file>
    <file>bootstrap.php</file>
    <exclude-pattern>uploads/*</exclude-pattern>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="220"/>
        </properties>
    </rule>
</ruleset>
